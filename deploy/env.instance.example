# Template .env untuk SATU instance WAHA = SATU nomor WhatsApp = SATU bisnis
# Disalin otomatis oleh `wahactl new <slug>`, lalu edit sesuai kebutuhan.

# ==========================================
# ===== IDENTITAS & RESOURCE INSTANCE ======
# ==========================================
# Slug bisnis, dipakai untuk nama container & project compose
WAHA_INSTANCE=CHANGE_ME
# Port di 127.0.0.1 (unik per instance, dialokasikan oleh wahactl)
WAHA_PORT=3101
# Image hasil build dari source repo ini.
#   waha-local:nobrowser -> untuk engine GOWS / NOWEB (tanpa Chromium)
#   waha-local:browser   -> untuk engine WEBJS / WPP  (dengan Chromium)
WAHA_IMAGE=waha-local:nobrowser

# Batas resource. GOWS/NOWEB ringan: 512m-1g. WEBJS/WPP berat: 2-3g.
WAHA_MEM_LIMIT=1g
WAHA_CPUS=1.0
WAHA_NODE_HEAP_MB=768
# Tanpa Chromium /dev/shm besar tidak diperlukan (WEBJS/WPP: 1gb)
WAHA_SHM_SIZE=256mb

# ====================
# ===== SECURITY =====
# ====================
# API key khusus bisnis ini. Bisnis lain TIDAK bisa pakai key ini karena
# containernya beda. (Manajemen multi-API-key dalam 1 container = fitur Plus.)
WAHA_API_KEY=CHANGE_ME
WAHA_DASHBOARD_ENABLED=True
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME
WHATSAPP_SWAGGER_ENABLED=True
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=CHANGE_ME

# ==================
# ===== COMMON =====
# ==================
# GOWS / NOWEB = ringan, tanpa browser (pakai image waha-local:nobrowser)
# WEBJS / WPP  = fitur paling lengkap, berat (pakai image waha-local:browser)
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_NAMESPACE=all

# Tanpa browser xvfb tidak dibutuhkan. Hapus baris ini kalau pakai WEBJS/WPP.
WAHA_RUN_XVFB=false

# Domain publik instance ini (dipakai `wahactl nginx <slug>` untuk render vhost)
WAHA_DOMAIN=CHANGE_ME.example.com
# URL publik instance ini. WAJIB benar, dipakai untuk URL file media & webhook.
WAHA_BASE_URL=https://CHANGE_ME.example.com

# Nama device yang muncul di "Linked Devices" HP
# WAHA_CLIENT_DEVICE_NAME=NamaBisnis

# Auto-start session `default` waktu container hidup
WHATSAPP_START_SESSION=default
WHATSAPP_RESTART_ALL_SESSIONS=True

# ===================
# ===== LOGGING =====
# ===================
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False

# =========================
# ===== MEDIA STORAGE =====
# =========================
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_FOLDER=/app/.media
# 0 = simpan selamanya. Isi detik (mis. 604800 = 7 hari) supaya disk server
# tidak penuh dan mengganggu project lain.
WHATSAPP_FILES_LIFETIME=0

# ==================
# ===== WEBHOOK =====
# ==================
# Endpoint aplikasi bisnis ini yang menerima pesan masuk
# WHATSAPP_HOOK_URL=https://app-bisnis-ini.example.com/webhook/waha
# WHATSAPP_HOOK_EVENTS=session.status,message,message.any,message.ack
# WHATSAPP_HOOK_CUSTOM_HEADERS=x-webhook-token:CHANGE_ME

# ===================
# ===== LAINNYA =====
# ===================
TZ=Asia/Jakarta
