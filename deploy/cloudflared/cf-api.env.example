# Kredensial Cloudflare supaya `wahactl add <slug>` bisa membuat subdomain,
# rute tunnel, dan record DNS sendiri - tanpa klik-klik di dashboard.
#
# Salin ke /opt/waha/cloudflared/cf-api.env lalu isi. File ini WAJIB chmod 600.
# Kalau file ini tidak ada, wahactl tetap jalan: rutenya saja yang harus dibuat
# manual lewat dashboard tunnel.
#
# API token dibuat di: dash.cloudflare.com -> profil -> API Tokens
# -> Create Custom Token, dengan permission:
#   Account -> Cloudflare Tunnel -> Edit
#   Zone    -> DNS               -> Edit
#   Zone    -> Zone              -> Read

CF_API_TOKEN=
# Account ID: terlihat di URL dashboard Zero Trust
CF_ACCOUNT_ID=
# Tunnel ID: halaman tunnel -> Basic Information -> Tunnel ID
CF_TUNNEL_ID=
# Zone ID: halaman Overview domain -> kolom kanan bawah
CF_ZONE_ID=

# Subdomain tiap instance dibentuk otomatis: wa-<slug>.<WAHA_DOMAIN_SUFFIX>
WAHA_DOMAIN_SUFFIX=
